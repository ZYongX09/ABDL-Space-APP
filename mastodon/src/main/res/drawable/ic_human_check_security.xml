<?xml version="1.0" encoding="utf-8"?>
<!--
    Hand-traced security illustration; paired source: assets/illustrations/human-check-security.svg.
    192-unit circular artwork; the phone continues below and is clipped by the circle.
    M3 theme colors stay live (including manually selected dark/dynamic palettes).
    Do not apply a whole-drawable tint: it would flatten the gradients and the check.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

    <group android:name="circularIllustration">
        <clip-path
            android:name="circularCrop"
            android:pathData="M96,0 A96,96 0,1 1,96,192 A96,96 0,1 1,96,0 Z" />

        <path
            android:name="paleCircularBackground"
            android:fillAlpha="0.18"
            android:pathData="M96,0 A96,96 0,1 1,96,192 A96,96 0,1 1,96,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="0" android:startY="96"
                    android:endX="192" android:endY="96">
                    <item android:offset="0" android:color="?attr/colorM3SecondaryContainer" />
                    <item android:offset="1" android:color="?attr/colorM3PrimaryContainer" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:name="phoneOutline"
            android:fillColor="#00000000"
            android:strokeWidth="3.7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M45.8,198 L45.8,159.4 C45.8,150.1 51.6,143.8 60.5,143.8 L131.5,143.8 C140.4,143.8 146.2,150.1 146.2,159.4 L146.2,198">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear"
                    android:startX="96" android:startY="142"
                    android:endX="96" android:endY="184">
                    <item android:offset="0" android:color="?attr/colorM3Primary" />
                    <item android:offset="1" android:color="?attr/colorM3Secondary" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:name="phoneEarpiece"
            android:fillColor="#00000000"
            android:strokeColor="?attr/colorM3Primary"
            android:strokeWidth="5.6"
            android:strokeLineCap="round"
            android:pathData="M83.5,160.3 L108.5,160.3" />

        <path
            android:name="shieldBevel"
            android:pathData="M95.9,36.5 C101.7,36.5 105,41.3 113.1,44.1 C118.6,46.1 125.2,47.5 130.3,48.8 C132.9,49.4 134.6,51.2 134.6,54 L134.6,70.4 C134.6,92.2 123,109.1 102.5,118.7 C98.3,120.7 94.8,121.1 90.4,119.3 C69,110.4 57.6,92.7 57.6,70.6 L57.6,54.2 C57.6,51.5 59.3,49.5 62.4,48.9 C75.5,46.5 82.3,43.7 88.5,39.5 C91,37.8 93.1,36.5 95.9,36.5 Z">
