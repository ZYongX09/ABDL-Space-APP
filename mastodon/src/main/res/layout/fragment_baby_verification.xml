<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/verification_scroll"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/vrPage"
	android:clipToPadding="false"
	android:fillViewport="true">

	<org.joinmastodon.android.ui.views.MaxWidthFrameLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_gravity="center_horizontal"
		android:maxWidth="@dimen/verification_content_max_width">

		<FrameLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<include
				android:id="@+id/verification_form_card"
				layout="@layout/verification_page_intro"
				android:layout_width="match_parent"
				android:layout_height="match_parent"/>

			<include
				android:id="@+id/verification_requirements_page"
				layout="@layout/verification_page_requirements"
				android:layout_width="match_parent"
				android:layout_height="match_parent"/>

			<include
				android:id="@+id/verification_status_page"
				layout="@layout/verification_page_status"
				android:layout_width="match_parent"
				android:layout_height="match_parent"/>

			<include
				android:id="@+id/verification_uploading_page"
				layout="@layout/verification_page_uploading"
				android:layout_width="match_parent"
				android:layout_height="match_parent"/>

			<LinearLayout
				android:id="@+id/verification_loading_state"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="?attr/vrPage"
				android:gravity="center"
				android:orientation="vertical"
				android:paddingStart="20dp"
				android:paddingEnd="20dp"
				android:visibility="gone">

				<ProgressBar
					android:layout_width="36dp"
					android:layout_height="36dp"
					android:indeterminateTint="?attr/vrPrimary"/>

				<TextView
					android:id="@+id/verification_loading_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:accessibilityLiveRegion="polite"
					android:text="@string/verification_status_loading"
					android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Subtitle"/>
			</LinearLayout>

			<ScrollView
				android:id="@+id/verification_message_scroll"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="?attr/vrPage"
				android:fillViewport="true"
				android:visibility="gone">

				<LinearLayout
					android:id="@+id/verification_message_card"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical"
					android:paddingStart="20dp"
					android:paddingTop="8dp"
					android:paddingEnd="20dp"
					android:paddingBottom="20dp">

					<FrameLayout
						android:layout_width="match_parent"
						android:layout_height="36dp">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_gravity="end|center_vertical"
							android:background="@drawable/vr_bg_pill"
							android:drawableStart="@drawable/ic_vr_globe_20"
							android:drawablePadding="6dp"
							android:gravity="center"
							android:minWidth="64dp"
							android:paddingStart="12dp"
							android:paddingTop="5dp"
							android:paddingEnd="12dp"
							android:paddingBottom="5dp"
							android:text="ZH"
							android:textColor="?attr/vrTextPrimary"
							android:textSize="12sp"/>
					</FrameLayout>

					<TextView
						android:id="@+id/verification_message_title"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="18dp"
						android:accessibilityLiveRegion="polite"
						android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Title"/>

					<TextView
						android:id="@+id/verification_message_body"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:lineSpacingExtra="2dp"
						android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Subtitle"/>

					<ProgressBar
						android:id="@+id/verification_message_progress"
						style="?android:attr/progressBarStyleHorizontal"
						android:layout_width="match_parent"
						android:layout_height="4dp"
						android:layout_marginTop="20dp"
						android:indeterminate="true"
						android:indeterminateTint="?attr/vrPrimary"
						android:visibility="gone"/>

					<Space
						android:layout_width="match_parent"
						android:layout_height="0dp"
						android:layout_weight="1"
						android:minHeight="24dp"/>

					<Button
						android:id="@+id/verification_message_primary"
						style="@style/Widget.Mastodon.Verification2.PrimaryButton"
						android:layout_width="match_parent"
						android:layout_height="52dp"
						android:visibility="gone"/>

					<Button
						android:id="@+id/verification_message_secondary"
						style="@style/Widget.Mastodon.Verification2.SecondaryButton"
						android:layout_width="match_parent"
						android:layout_height="52dp"
						android:layout_marginTop="10dp"
						android:visibility="gone"/>

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="@string/vr_footer"
						android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Footer"/>
				</LinearLayout>
			</ScrollView>

			<org.joinmastodon.android.ui.views.BabyVerificationProgressView
				android:id="@+id/verification_progress_steps"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:visibility="gone"/>
		</FrameLayout>
	</org.joinmastodon.android.ui.views.MaxWidthFrameLayout>
</ScrollView>
