<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card_with_border"
    android:elevation="1dp"
    android:padding="16dp">

    <!-- 第一层：头像 + 用户名 + 菜单 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/fr_timeline_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:contentDescription="头像" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/fr_timeline_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="?android:textColorPrimary"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/fr_timeline_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="?colorM3OnPrimaryContainer"
                android:background="@drawable/bg_tag_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/fr_timeline_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:src="@drawable/ic_fluent_more_vertical_24_regular"
            android:tint="?android:textColorTertiary"
            android:contentDescription="菜单"
            android:scaleType="centerInside" />

    </LinearLayout>

    <TextView
        android:id="@+id/fr_timeline_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:textColorPrimary"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/fr_timeline_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:includeFontPadding="false" />

    <!-- 基础信息：年龄·性别·城市 -->
    <TextView
        android:id="@+id/fr_timeline_basic_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="15sp"
        android:textColor="?android:textColorSecondary"
        android:includeFontPadding="false" />

    <!-- Metadata 图标行 -->
    <org.joinmastodon.android.ui.views.FlowLayout
        android:id="@+id/fr_timeline_meta_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?android:attr/listDivider" />

    <!-- 底部：评论 + 时间 + 交友查看按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/fr_timeline_comment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/friend_universe_branding"
            android:textSize="13sp"
            android:textColor="?android:textColorSecondary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/fr_timeline_publish_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textSize="12sp"
            android:textColor="?android:textColorTertiary"
            android:gravity="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/fr_timeline_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/friend_request_chat_button"
            android:textSize="13sp"
            android:textColor="?colorM3OnPrimaryContainer"
            android:background="@drawable/bg_tag_blue"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:includeFontPadding="false" />

    </LinearLayout>

</LinearLayout>
