<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/newbabyworld_card"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginHorizontal="16dp"
	android:layout_marginTop="8dp"
	android:layout_marginBottom="4dp"
	android:padding="16dp"
	android:background="@drawable/bg_settings_banner">

	<ImageView
		android:id="@+id/newbabyworld_card_icon"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginEnd="16dp"
		android:background="@drawable/white_circle"
		android:backgroundTint="?colorM3PrimaryContainer"
		android:padding="8dp"
		android:src="@drawable/ic_nbw_logo"
		android:tint="?colorM3OnPrimaryContainer"
		android:importantForAccessibility="no" />

	<TextView
		android:id="@+id/newbabyworld_card_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_toEndOf="@id/newbabyworld_card_icon"
		android:textAppearance="@style/m3_title_medium"
		android:textColor="?colorM3OnSurface"
		android:text="@string/compose_newbabyworld_title" />

	<TextView
		android:id="@+id/newbabyworld_card_text"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_below="@id/newbabyworld_card_title"
		android:layout_toEndOf="@id/newbabyworld_card_icon"
		android:layout_marginTop="2dp"
		android:textAppearance="@style/m3_body_medium"
		android:textColor="?colorM3OnSurface" />

	<Button
		android:id="@+id/newbabyworld_card_action"
		android:layout_width="wrap_content"
		android:layout_height="28dp"
		android:layout_below="@id/newbabyworld_card_text"
		android:layout_toEndOf="@id/newbabyworld_card_icon"
		android:layout_marginStart="-8dp"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="-4dp"
		android:minWidth="0dp"
		android:paddingHorizontal="8dp"
		android:paddingVertical="4dp"
		android:textAppearance="@style/m3_label_large"
		style="@style/Widget.Mastodon.M3.Button.Text" />
</RelativeLayout>
