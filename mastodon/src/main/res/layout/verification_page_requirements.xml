<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/verification_requirements_page"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/vr_page"
	android:orientation="vertical"
	android:visibility="gone">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="46dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp">

		<ImageButton
			android:id="@+id/verification_back_requirements"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:layout_gravity="start|top"
			android:layout_marginTop="5dp"
			android:background="@android:color/transparent"
			android:contentDescription="@string/back"
			android:padding="8dp"
			android:src="@drawable/ic_fluent_arrow_left_24_regular"
			android:tint="@color/vr_text_primary"/>

		<TextView
			android:id="@+id/verification_locale_pill_requirements"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end|top"
			android:layout_marginTop="12dp"
			android:background="@drawable/vr_bg_pill"
			android:drawableStart="@drawable/ic_vr_globe_20"
			android:drawablePadding="5dp"
			android:gravity="center"
			android:minWidth="48dp"
			android:paddingStart="9dp"
			android:paddingTop="6dp"
			android:paddingEnd="7dp"
			android:paddingBottom="6dp"
			android:text="ZH"
			android:textColor="@color/vr_text_primary"
			android:textSize="11sp"/>
	</FrameLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:orientation="vertical"
		android:paddingStart="17dp"
		android:paddingTop="14dp"
		android:paddingEnd="17dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/vr_bg_info"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="12dp"
			android:paddingTop="9dp"
			android:paddingEnd="12dp"
			android:paddingBottom="9dp">

			<ImageView
				android:layout_width="13dp"
				android:layout_height="13dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_fluent_clock_24_regular"
				android:tint="@color/vr_primary"/>

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="7dp"
				android:layout_weight="1"
				android:text="@string/vr_req_remaining"
				android:textColor="@color/vr_text_secondary"
				android:textSize="11.5sp"
				android:fontFamily="sans-serif-medium"/>

			<TextView
				android:id="@+id/vr_req_countdown"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="--:--"
				android:textColor="@color/vr_text_primary"
				android:textSize="14sp"
				android:fontFamily="sans-serif-medium"/>
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="13dp"
			android:orientation="vertical">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/vr_req_title"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Title"/>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="7dp"
				android:text="@string/vr_req_subtitle"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Subtitle"/>
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="13dp"
			android:background="@drawable/vr_bg_info_large"
			android:orientation="vertical"
			android:paddingStart="14dp"
			android:paddingTop="12dp"
			android:paddingEnd="14dp"
			android:paddingBottom="12dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/vr_req_section_wear"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Section"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="17dp"
					android:layout_height="17dp"
					android:background="@drawable/vr_bg_step"
					android:gravity="center"
					android:includeFontPadding="false"
					android:text="1"
					android:textColor="@color/vr_step_text"
					android:textSize="9.5sp"
					android:textStyle="bold"/>

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="9dp"
					android:layout_weight="1"
					android:text="@string/vr_req_step1"
					android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Body"/>
			</LinearLayout>

			<View
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_marginTop="10dp"
				android:layout_marginBottom="10dp"
				android:background="@color/vr_info_divider"/>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/vr_req_section_paper"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Section"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="17dp"
					android:layout_height="17dp"
					android:background="@drawable/vr_bg_step"
					android:gravity="center"
					android:includeFontPadding="false"
					android:text="2"
					android:textColor="@color/vr_step_text"
					android:textSize="9.5sp"
					android:textStyle="bold"/>

				<TextView
					android:id="@+id/vr_req_step2"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="9dp"
					android:layout_weight="1"
					android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Body"/>
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="horizontal">

				<TextView
					android:layout_width="17dp"
					android:layout_height="17dp"
					android:background="@drawable/vr_bg_step"
					android:gravity="center"
					android:includeFontPadding="false"
					android:text="3"
					android:textColor="@color/vr_step_text"
					android:textSize="9.5sp"
					android:textStyle="bold"/>

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="9dp"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/vr_req_step3"
						android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Body"/>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:background="@drawable/vr_bg_field"
						android:orientation="vertical"
						android:paddingStart="12dp"
						android:paddingTop="10dp"
						android:paddingEnd="12dp"
						android:paddingBottom="10dp">

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_vertical"
							android:orientation="horizontal">

							<TextView
								android:layout_width="60dp"
								android:layout_height="wrap_content"
								android:text="@string/vr_req_user_id"
								android:textColor="@color/vr_text_secondary"
								android:textSize="11sp"/>

							<TextView
								android:id="@+id/vr_req_user_value"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="8dp"
								android:layout_weight="1"
								android:textColor="@color/vr_text_primary"
								android:textSize="11.5sp"
								android:fontFamily="sans-serif-medium"/>
						</LinearLayout>

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:gravity="center_vertical"
							android:orientation="horizontal">

							<TextView
								android:layout_width="60dp"
								android:layout_height="wrap_content"
								android:text="@string/vr_req_random_text"
								android:textColor="@color/vr_text_secondary"
								android:textSize="11sp"/>

							<TextView
								android:id="@+id/vr_req_text_value"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_marginStart="8dp"
								android:layout_weight="1"
								android:textColor="@color/vr_text_primary"
								android:textSize="11.5sp"
								android:fontFamily="sans-serif-medium"/>
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>

			<View
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_marginTop="10dp"
				android:layout_marginBottom="10dp"
				android:background="@color/vr_info_divider"/>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/vr_req_section_place"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Section"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="horizontal">

				<TextView
					android:layout_width="17dp"
					android:layout_height="17dp"
					android:background="@drawable/vr_bg_step"
					android:gravity="center"
					android:includeFontPadding="false"
					android:text="4"
					android:textColor="@color/vr_step_text"
					android:textSize="9.5sp"
					android:textStyle="bold"/>

				<TextView
					android:id="@+id/vr_req_step4"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="9dp"
					android:layout_weight="1"
					android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Body"/>
			</LinearLayout>
		</LinearLayout>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="13dp"
			android:text="@string/vr_req_tips_title"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Section"/>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:orientation="vertical">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:lineSpacingExtra="2dp"
				android:text="@string/vr_req_tips"
				android:textColor="@color/vr_text_secondary"
				android:textSize="11.5sp"/>
		</LinearLayout>

		<Space
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:minHeight="12dp"/>
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="10dp"
		android:paddingEnd="16dp"
		android:paddingBottom="16dp">

		<Button
			android:id="@+id/vr_req_start"
			style="@style/Widget.Mastodon.Verification2.PrimaryButton"
			android:layout_width="match_parent"
			android:layout_height="43dp"
			android:text="@string/vr_req_start"/>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center"
			android:text="@string/vr_footer"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Footer"/>
	</LinearLayout>
</LinearLayout>
