<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_diaper_card"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp">

    <!-- 品牌Logo -->
    <ImageView
        android:id="@+id/brand_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:background="@drawable/bg_diaper_logo"
        android:contentDescription="品牌Logo" />

    <!-- 信息区域 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- 品牌 + 型号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/brand_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/baby_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="婴儿"
                android:textSize="10sp"
                android:textColor="#FF6B6B"
                android:background="@drawable/bg_tag_red"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 评分 + 评价数 + 吸收量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_fluent_star_24_filled"
                android:tint="#FFB300"
                android:contentDescription="评分" />

            <TextView
                android:id="@+id/avg_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFB300"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/rating_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textColor="?android:textColorTertiary"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/absorbency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textColor="?android:textColorTertiary"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右箭头 -->
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_fluent_chevron_right_24_regular"
        android:tint="#666666"
        android:contentDescription="详情" />

</LinearLayout>
