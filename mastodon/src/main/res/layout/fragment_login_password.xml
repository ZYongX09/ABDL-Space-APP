<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.joinmastodon.android.ui.views.SpaceBackgroundView
        android:id="@+id/space_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_abdl_icon"
            android:scaleType="fitCenter"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/general_explore_world"
            android:textSize="13sp"
            android:textColor="#88AACC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <EditText
                android:id="@+id/email_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_light"
                android:hint="@string/general_login_account_hint"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#333333"
                android:textColorHint="?colorM3OnSurfaceVariant"
                android:drawableStart="@drawable/ic_email_24"
                android:drawablePadding="12dp"
                android:drawableTint="?colorM3OnSurfaceVariant"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <EditText
                android:id="@+id/password_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_light"
                android:hint="@string/general_password_hint"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#333333"
                android:textColorHint="?colorM3OnSurfaceVariant"
                android:drawableStart="@drawable/ic_lock_24"
                android:drawablePadding="12dp"
                android:drawableTint="?colorM3OnSurfaceVariant"
                android:drawableEnd="@drawable/ic_eye_toggle"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:backgroundTint="@null" />

            <LinearLayout
                android:id="@+id/agreement_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <CheckBox
                    android:id="@+id/cb_agreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#A1D9F7" />

                <TextView
                    android:id="@+id/tv_agreement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="?colorM3OnSurfaceVariant" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/bg_btn_gradient_purple"
                android:text="@string/log_in"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:enabled="false"
                android:textColor="#FFFFFF" android:singleLine="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="?colorM3Outline" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/general_other_login" android:textSize="12sp" android:textColor="?colorM3OnSurfaceVariant" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="?colorM3Outline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <FrameLayout
                    android:id="@+id/btn_nbw"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_circle_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/nbw_third_party_nbw">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_nbw" android:scaleType="fitCenter" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/btn_qq"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_circle_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/qq_login">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_qq_login" android:scaleType="fitCenter" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/btn_oauth"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="ABDL Space">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_abdl_icon" android:scaleType="fitCenter" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.3" />

        <TextView
            android:id="@+id/btn_code_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/general_code_login"
            android:textSize="15sp"
            android:textColor="#88AAFF"
            android:padding="8dp" />

    </LinearLayout>
    </ScrollView>
</FrameLayout>
