<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?colorM3Background"
    android:gravity="center_horizontal">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="20dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitCenter"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="欢迎登录 ABDL Space"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="?colorM3OnSurface" />

    <EditText
        android:id="@+id/email_edit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pin_input"
        android:hint="请输入邮箱"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="#333333"
        android:textColorHint="#AAAAAA"
        android:drawableStart="@drawable/ic_email_24"
        android:drawablePadding="12dp"
        android:drawableTint="#AAAAAA" />

    <EditText
        android:id="@+id/password_edit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_pin_input"
        android:hint="请输入密码"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="#333333"
        android:textColorHint="#AAAAAA"
        android:drawableStart="@drawable/ic_lock_24"
        android:drawablePadding="12dp"
        android:drawableTint="#AAAAAA"
        android:drawableEnd="@drawable/ic_eye_toggle"
        android:backgroundTint="@null" />

    <LinearLayout
        android:id="@+id/agreement_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp">

        <CheckBox
            android:id="@+id/cb_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#4FC3F7" />

        <TextView
            android:id="@+id/tv_agreement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#666666" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_baby_blue"
        android:text="登录"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:enabled="false"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/btn_code_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="验证码登录"
        android:textSize="15sp"
        android:textColor="#4FC3F7"
        android:gravity="center"
        android:padding="8dp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0E0E0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  其他登录方式  "
                android:textSize="12sp"
                android:textColor="#AAAAAA" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0E0E0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/btn_nbw"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_gray"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="宝宝新天地">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nbw"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_oauth"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_gray"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="ABDL Space">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_abdl_icon"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
