<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.joinmastodon.android.ui.views.SpaceBackgroundView
        android:id="@+id/space_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="⭐ 探索全新世界 ⭐"
            android:textSize="13sp"
            android:textColor="#88AACC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <EditText
                android:id="@+id/email_edit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_light"
                android:hint="请输入邮箱"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#333333"
                android:textColorHint="#AABBCC"
                android:drawableStart="@drawable/ic_email_24"
                android:drawablePadding="12dp"
                android:drawableTint="#8899BB"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <EditText
                android:id="@+id/password_edit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_glass_light"
                android:hint="请输入密码"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#333333"
                android:textColorHint="#AABBCC"
                android:drawableStart="@drawable/ic_lock_24"
                android:drawablePadding="12dp"
                android:drawableTint="#8899BB"
                android:drawableEnd="@drawable/ic_eye_toggle"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:backgroundTint="@null" />

            <LinearLayout
                android:id="@+id/agreement_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/cb_agreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#88AAFF" />

                <TextView
                    android:id="@+id/tv_agreement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="#7788AA" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_gradient_purple"
                android:text="登录"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:enabled="false"
                android:textColor="#FFFFFF"
                android:elevation="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#15000000" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  或使用其他方式登录  " android:textSize="12sp" android:textColor="#99AABB" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#15000000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <FrameLayout
                    android:id="@+id/btn_nbw"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_circle_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="宝宝新天地">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_nbw" android:scaleType="fitCenter" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/btn_oauth"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="ABDL Space">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_abdl_icon" android:scaleType="fitCenter" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.3" />

        <TextView
            android:id="@+id/btn_code_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="验证码登录"
            android:textSize="15sp"
            android:textColor="#88AAFF"
            android:padding="8dp" />

    </LinearLayout>
</FrameLayout>
