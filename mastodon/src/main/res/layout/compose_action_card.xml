<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">
    <ImageView
        android:id="@+id/compose_action_card_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/compose_action_card_title"
        style="@style/compose_action_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/compose_action_card_description"
        style="@style/compose_action_card_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no" />
</LinearLayout>
