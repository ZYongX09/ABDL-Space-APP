<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/verification_uploading_page"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/vr_page"
	android:orientation="vertical"
	android:visibility="gone">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="46dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp">

		<ImageButton
			android:id="@+id/verification_back_uploading"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:layout_gravity="start|top"
			android:layout_marginTop="5dp"
			android:background="@android:color/transparent"
			android:contentDescription="@string/back"
			android:padding="8dp"
			android:src="@drawable/ic_fluent_arrow_left_24_regular"
			android:tint="@color/vr_text_primary"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end|top"
			android:layout_marginTop="12dp"
			android:background="@drawable/vr_bg_pill"
			android:drawableStart="@drawable/ic_vr_globe_20"
			android:drawablePadding="5dp"
			android:gravity="center"
			android:minWidth="48dp"
			android:paddingStart="9dp"
			android:paddingTop="6dp"
			android:paddingEnd="7dp"
			android:paddingBottom="6dp"
			android:text="ZH"
			android:textColor="@color/vr_text_primary"
			android:textSize="11sp"/>
	</FrameLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp">

		<ProgressBar
			android:id="@+id/vr_up_progress"
			android:layout_width="46dp"
			android:layout_height="46dp"
			android:indeterminateTint="@color/vr_primary"/>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="18dp"
			android:gravity="center"
			android:text="@string/vr_up_title"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Title"/>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:gravity="center"
			android:text="@string/vr_up_subtitle"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Subtitle"/>

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="24dp"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<ImageView
					android:id="@+id/vr_up_step1_icon"
					android:layout_width="18dp"
					android:layout_height="18dp"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_fluent_checkmark_circle_24_filled"
					android:tint="@color/vr_success"
					android:visibility="invisible"/>

				<ProgressBar
					android:id="@+id/vr_up_step1_progress"
					android:layout_width="16dp"
					android:layout_height="16dp"
					android:layout_marginStart="1dp"
					android:indeterminateTint="@color/vr_primary"/>

				<TextView
					android:id="@+id/vr_up_step1_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="10dp"
					android:text="@string/vr_up_step1"
					android:textColor="@color/vr_text_primary"
					android:textSize="12sp"/>
			</LinearLayout>

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<ImageView
					android:id="@+id/vr_up_step2_icon"
					android:layout_width="18dp"
					android:layout_height="18dp"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_fluent_checkmark_circle_24_filled"
					android:tint="@color/vr_success"
					android:visibility="invisible"/>

				<ProgressBar
					android:id="@+id/vr_up_step2_progress"
					android:layout_width="16dp"
					android:layout_height="16dp"
					android:layout_marginStart="1dp"
					android:indeterminateTint="@color/vr_primary"
					android:visibility="invisible"/>

				<TextView
					android:id="@+id/vr_up_step2_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="10dp"
					android:text="@string/vr_up_step2"
					android:textColor="@color/vr_text_primary"
					android:textSize="12sp"/>
			</LinearLayout>

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<ImageView
					android:id="@+id/vr_up_step3_icon"
					android:layout_width="18dp"
					android:layout_height="18dp"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_fluent_checkmark_circle_24_filled"
					android:tint="@color/vr_success"
					android:visibility="invisible"/>

				<ProgressBar
					android:id="@+id/vr_up_step3_progress"
					android:layout_width="16dp"
					android:layout_height="16dp"
					android:layout_marginStart="1dp"
					android:indeterminateTint="@color/vr_primary"
					android:visibility="invisible"/>

				<TextView
					android:id="@+id/vr_up_step3_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="10dp"
					android:text="@string/vr_up_step3"
					android:textColor="@color/vr_text_primary"
					android:textSize="12sp"/>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="10dp"
		android:paddingEnd="16dp"
		android:paddingBottom="16dp">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/vr_footer"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Footer"/>
	</LinearLayout>
</LinearLayout>
