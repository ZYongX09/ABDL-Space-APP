<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/verification_uploading_page"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/vr_page"
	android:orientation="vertical"
	android:paddingStart="20dp"
	android:paddingTop="8dp"
	android:paddingEnd="20dp"
	android:paddingBottom="20dp"
	android:visibility="gone">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="36dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end|center_vertical"
			android:background="@drawable/vr_bg_pill"
			android:drawableStart="@drawable/ic_vr_globe_20"
			android:drawablePadding="6dp"
			android:gravity="center"
			android:minWidth="64dp"
			android:paddingStart="12dp"
			android:paddingTop="5dp"
			android:paddingEnd="12dp"
			android:paddingBottom="5dp"
			android:text="ZH"
			android:textColor="@color/vr_text_primary"
			android:textSize="12sp"/>
	</FrameLayout>

	<Space
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:minHeight="24dp"/>

	<ProgressBar
		android:id="@+id/vr_up_progress"
		android:layout_width="56dp"
		android:layout_height="56dp"
		android:layout_gravity="center_horizontal"
		android:indeterminateTint="@color/vr_primary"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="18dp"
		android:gravity="center"
		android:text="@string/vr_up_title"
		android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Title"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:gravity="center"
		android:text="@string/vr_up_subtitle"
		android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Subtitle"/>

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:layout_marginTop="30dp"
		android:orientation="vertical">

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ImageView
				android:id="@+id/vr_up_step1_icon"
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_fluent_checkmark_circle_24_filled"
				android:tint="@color/vr_success"
				android:visibility="invisible"/>

			<ProgressBar
				android:id="@+id/vr_up_step1_progress"
				android:layout_width="16dp"
				android:layout_height="16dp"
				android:layout_marginStart="2dp"
				android:indeterminateTint="@color/vr_primary"/>

			<TextView
				android:id="@+id/vr_up_step1_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:text="@string/vr_up_step1"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Body"/>
		</LinearLayout>

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="14dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ImageView
				android:id="@+id/vr_up_step2_icon"
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_fluent_checkmark_circle_24_filled"
				android:tint="@color/vr_success"
				android:visibility="invisible"/>

			<ProgressBar
				android:id="@+id/vr_up_step2_progress"
				android:layout_width="16dp"
				android:layout_height="16dp"
				android:layout_marginStart="2dp"
				android:indeterminateTint="@color/vr_primary"
				android:visibility="invisible"/>

			<TextView
				android:id="@+id/vr_up_step2_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:text="@string/vr_up_step2"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Body"/>
		</LinearLayout>

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="14dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<ImageView
				android:id="@+id/vr_up_step3_icon"
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_fluent_checkmark_circle_24_filled"
				android:tint="@color/vr_success"
				android:visibility="invisible"/>

			<ProgressBar
				android:id="@+id/vr_up_step3_progress"
				android:layout_width="16dp"
				android:layout_height="16dp"
				android:layout_marginStart="2dp"
				android:indeterminateTint="@color/vr_primary"
				android:visibility="invisible"/>

			<TextView
				android:id="@+id/vr_up_step3_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:text="@string/vr_up_step3"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Body"/>
		</LinearLayout>
	</LinearLayout>

	<Space
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1.4"
		android:minHeight="24dp"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/vr_footer"
		android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Footer"/>
</LinearLayout>
