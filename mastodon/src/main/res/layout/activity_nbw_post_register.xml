<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.joinmastodon.android.ui.views.SpaceBackgroundView
        android:id="@+id/space_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipToPadding="false">

        <!-- Only the settings entry exposes an in-page back control. -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            android:tint="?colorM3OnSurface"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/nbw_connection_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nbw_v2_connection_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?colorM3OnSurface"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:gravity="start" />

        <ScrollView
            android:id="@+id/nbw_connection_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/nbw_connection_logo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:src="@drawable/ic_nbw_large"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_circle_white"
                    android:padding="12dp"
                    android:contentDescription="@string/nbw_third_party_nbw" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nbw_third_party_nbw"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?colorM3OnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="ABDL Space 联邦·深度合作成员"
                    android:textSize="13sp"
                    android:textColor="?colorM3OnSurfaceVariant" />

                <TextView
                    android:id="@+id/nbw_connection_explanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/nbw_v2_publish_explanation"
                    android:textSize="14sp"
                    android:textColor="?colorM3OnSurfaceVariant"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/nbw_connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/nbw_v2_connection_unavailable"
                    android:textSize="14sp"
                    android:textColor="?colorM3OnSurface"
                    android:lineSpacingExtra="4dp"
                    android:accessibilityLiveRegion="polite" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_with_border"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_info_24px"
                        android:tint="?colorM3OnSurfaceVariant"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/nbw_connection_local_publish"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nbw_v2_local_publish_unaffected"
                        android:textSize="13sp"
                        android:textColor="?colorM3OnSurfaceVariant" />
                </LinearLayout>

                <!-- The old solid light-blue rounded primary now starts only V2 authorization. -->
                <Button
                    android:id="@+id/btn_nbw_connect"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_btn_gradient_purple"
                    android:backgroundTint="@null"
                    android:text="@string/nbw_v2_connect"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:textColor="#10384D"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_nbw_settings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_btn_outline_blue"
                    android:backgroundTint="@null"
                    android:text="@string/nbw_v2_fallback_settings"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:textColor="?colorM3OnSurface"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_skip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:backgroundTint="@null"
                    android:text="暂时跳过"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="?colorM3Primary" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
