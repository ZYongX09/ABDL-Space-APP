<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="?colorM3Surface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_nbw_large"
            android:contentDescription="@string/nbw_login_title" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/nbw_login_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?colorM3OnSurface" />
        <ProgressBar
            android:id="@+id/nbw_login_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="24dp" />
        <TextView
            android:id="@+id/nbw_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:text="@string/nbw_login_starting"
            android:textSize="16sp"
            android:textColor="?colorM3OnSurfaceVariant" />
        <Button
            android:id="@+id/nbw_login_retry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="@string/nbw_login_retry"
            android:textAllCaps="false"
            android:visibility="gone" />
        <Button
            android:id="@+id/nbw_login_cancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/nbw_login_cancel"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
