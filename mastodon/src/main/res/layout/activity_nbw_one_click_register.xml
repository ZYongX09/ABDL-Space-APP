<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.joinmastodon.android.ui.views.SpaceBackgroundView
        android:id="@+id/space_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipToPadding="false">

        <!-- 返回按钮 + 刷新按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back_24"
                android:tint="?colorM3OnSurface"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:src="@drawable/ic_refresh_24"
                android:tint="?colorM3OnSurface"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/album_refresh" />
        </LinearLayout>

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:text="@string/general_one_click_register"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?colorM3OnSurface"
            android:gravity="start" />

        <!-- 阶段1：加载中 -->
        <LinearLayout
            android:id="@+id/phase_loading"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/general_nbw_register_loading"
                android:textSize="14sp"
                android:textColor="?colorM3OnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#FF6B6B"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_gradient_purple"
                android:text="@string/retry"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:visibility="gone" android:singleLine="false" />
        </LinearLayout>

        <!-- 阶段2：第一步已完成 -->
        <LinearLayout
            android:id="@+id/phase_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/ic_nbw_large"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_circle_gray"
                android:padding="16dp"
                android:contentDescription="@string/nbw_third_party_nbw" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/general_first_step_complete"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?colorM3OnSurface"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/general_nbw_complete_note"
                android:textSize="14sp"
                android:textColor="?colorM3OnSurfaceVariant"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btn_go_web"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:background="@drawable/bg_btn_gradient_purple"
                android:text="@string/general_nbw_complete_action"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" android:singleLine="false" />
        </LinearLayout>

        <!-- 阶段3：WebView + 底部横幅 -->
        <LinearLayout
            android:id="@+id/phase_webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_bar_webview"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 底部横幅 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FF0A0A12"
                android:padding="12dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                android:text="@string/general_nbw_registration_wait"
                android:textSize="12sp"
                android:textColor="?colorM3OnSurfaceVariant"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/btn_complete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                android:minHeight="48dp"
                    android:background="@drawable/bg_btn_gradient_purple"
                    android:text="@string/general_registration_complete"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="?colorM3OnSurface" android:singleLine="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
