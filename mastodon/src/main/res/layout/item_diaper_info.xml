<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_diaper_card"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="产品信息"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:textColorPrimary"
        android:includeFontPadding="false"
        android:layout_marginBottom="12dp" />

    <!-- 品牌 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="品牌"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:includeFontPadding="false" />

        <ImageView
            android:id="@+id/brand_logo"
            android:layout_width="60dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/brand_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 型号 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="型号"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/model_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 类型 -->
    <LinearLayout
        android:id="@+id/row_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="类型"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/type_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 厚度 -->
    <LinearLayout
        android:id="@+id/row_thickness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="厚度"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/thickness_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 成人实际吸收 -->
    <LinearLayout
        android:id="@+id/row_absorbency_adult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="成人实际吸收"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/absorbency_adult_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 厂家标称吸收 -->
    <LinearLayout
        android:id="@+id/row_absorbency_mfr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="厂家标称吸收"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/absorbency_mfr_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 参考价 -->
    <LinearLayout
        android:id="@+id/row_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="参考价"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/price_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:textColorPrimary"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 官网 -->
    <LinearLayout
        android:id="@+id/row_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="官网"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:includeFontPadding="false" />

        <TextView
        android:id="@+id/visit_url_btn"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
            android:text="访问官网"
            android:textSize="12sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_diaper_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout>
