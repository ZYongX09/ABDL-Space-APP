<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorM3Surface">

	<LinearLayout
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="64dp"
		android:background="?attr/colorM3Surface"
		android:elevation="1dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingEnd="16dp">

		<ImageButton
			android:id="@+id/back_btn"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:contentDescription="返回"
			android:src="@drawable/ic_arrow_back_24" />

	<ImageView
			android:id="@+id/peer_avatar"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="@drawable/image_placeholder"
			android:scaleType="centerCrop" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:id="@+id/peer_name"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:fontFamily="sans-serif-medium"
				android:maxLines="1"
				android:textColor="?attr/colorM3OnSurface"
				android:textSize="17sp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="1dp"
				android:text="私密对话"
				android:textColor="?attr/colorM3OnSurfaceVariant"
				android:textSize="12sp" />
		</LinearLayout>
	</LinearLayout>

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recycler"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="?attr/colorM3SurfaceVariant"
			android:clipToPadding="false"
			android:paddingTop="10dp"
			android:paddingBottom="10dp" />

	</FrameLayout>

	<LinearLayout
		android:id="@+id/input_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingStart="12dp"
		android:paddingTop="8dp"
		android:paddingEnd="8dp"
		android:paddingBottom="8dp"
		android:background="?attr/colorM3Surface"
		android:elevation="8dp">

		<FrameLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:background="@drawable/bg_chat_input">

			<EditText
				android:id="@+id/input"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@null"
				android:hint="输入消息"
				android:inputType="textCapSentences|textMultiLine"
				android:maxLines="5"
				android:minHeight="48dp"
				android:paddingHorizontal="16dp"
				android:paddingVertical="11dp"
				android:textColor="?attr/colorM3OnSurface"
				android:textColorHint="?attr/colorM3OnSurfaceVariant"
				android:textSize="15sp" />
		</FrameLayout>

		<ImageButton
			android:id="@+id/send_btn"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:layout_marginStart="8dp"
			android:background="@drawable/bg_chat_send"
			android:src="@drawable/ic_send_24px"
			android:contentDescription="发送" />
	</LinearLayout>
</LinearLayout>
