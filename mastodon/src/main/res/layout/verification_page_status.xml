<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/verification_status_page"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/vrPage"
	android:orientation="vertical"
	android:visibility="gone">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="46dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp">

		<ImageButton
			android:id="@+id/verification_back_status"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:layout_gravity="start|top"
			android:layout_marginTop="5dp"
			android:background="@android:color/transparent"
			android:contentDescription="@string/back"
			android:padding="8dp"
			android:src="@drawable/ic_fluent_arrow_left_24_regular"
			android:tint="?attr/vrTextPrimary"/>

		<TextView
			android:id="@+id/verification_locale_pill_status"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end|top"
			android:layout_marginTop="12dp"
			android:background="@drawable/vr_bg_pill"
			android:drawableStart="@drawable/ic_vr_globe_20"
			android:drawablePadding="5dp"
			android:gravity="center"
			android:minWidth="48dp"
			android:paddingStart="9dp"
			android:paddingTop="6dp"
			android:paddingEnd="7dp"
			android:paddingBottom="6dp"
			android:text="ZH"
			android:textColor="?attr/vrTextPrimary"
			android:textSize="11sp"/>
	</FrameLayout>

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingTop="16dp"
			android:paddingEnd="16dp"
			android:paddingBottom="24dp">

			<ImageView
				android:id="@+id/vr_status_icon"
				android:layout_width="60dp"
				android:layout_height="60dp"
				android:importantForAccessibility="no"
				android:padding="16dp"
				android:visibility="gone"/>

			<TextView
				android:id="@+id/vr_status_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:accessibilityLiveRegion="polite"
				android:gravity="center"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Title"/>

			<TextView
				android:id="@+id/vr_status_subtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:gravity="center"
				android:lineSpacingExtra="2dp"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Subtitle"/>

			<LinearLayout
				android:id="@+id/vr_status_content"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:orientation="vertical"/>
		</LinearLayout>
	</ScrollView>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="10dp"
		android:paddingEnd="16dp"
		android:paddingBottom="16dp">

		<Button
			android:id="@+id/vr_status_primary"
			style="@style/Widget.Mastodon.Verification2.PrimaryButton"
			android:layout_width="match_parent"
			android:layout_height="43dp"
			android:visibility="gone"/>

		<Button
			android:id="@+id/vr_status_secondary"
			style="@style/Widget.Mastodon.Verification2.TextButton"
			android:layout_width="match_parent"
			android:layout_height="43dp"
			android:layout_marginTop="8dp"
			android:visibility="gone"/>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center"
			android:text="@string/vr_footer"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Footer"/>
	</LinearLayout>
</LinearLayout>
