<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/verification_status_page"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/vr_page"
	android:orientation="vertical"
	android:paddingStart="20dp"
	android:paddingTop="8dp"
	android:paddingEnd="20dp"
	android:paddingBottom="20dp"
	android:visibility="gone">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="36dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end|center_vertical"
			android:background="@drawable/vr_bg_pill"
			android:drawableStart="@drawable/ic_vr_globe_20"
			android:drawablePadding="6dp"
			android:gravity="center"
			android:minWidth="64dp"
			android:paddingStart="12dp"
			android:paddingTop="5dp"
			android:paddingEnd="12dp"
			android:paddingBottom="5dp"
			android:text="ZH"
			android:textColor="@color/vr_text_primary"
			android:textSize="12sp"/>
	</FrameLayout>

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<TextView
				android:id="@+id/vr_status_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:accessibilityLiveRegion="polite"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Title"/>

			<TextView
				android:id="@+id/vr_status_subtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:lineSpacingExtra="2dp"
				android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Subtitle"/>

			<LinearLayout
				android:id="@+id/vr_status_content"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="18dp"
				android:orientation="vertical"/>
		</LinearLayout>
	</ScrollView>

	<Button
		android:id="@+id/vr_status_primary"
		style="@style/Widget.Mastodon.Verification2.PrimaryButton"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:visibility="gone"/>

	<Button
		android:id="@+id/vr_status_secondary"
		style="@style/Widget.Mastodon.Verification2.SecondaryButton"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginTop="10dp"
		android:visibility="gone"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:text="@string/vr_footer"
		android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Footer"/>
</LinearLayout>
