<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#000000">

	<TextureView
		android:id="@+id/camera_preview"
		android:layout_width="match_parent"
		android:layout_height="match_parent"/>

	<ImageView
		android:id="@+id/camera_review_image"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scaleType="fitCenter"
		android:visibility="gone"/>

	<VideoView
		android:id="@+id/camera_review_video"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone"/>

	<View
		android:id="@+id/camera_focus"
		android:layout_width="64dp"
		android:layout_height="64dp"
		android:background="@drawable/bg_media_camera_focus"
		android:visibility="gone"/>

	<LinearLayout
		android:id="@+id/camera_top_controls"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="12dp"
		android:paddingTop="12dp"
		android:paddingEnd="12dp">

		<ImageButton
			android:id="@+id/camera_back"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="@android:color/transparent"
			android:contentDescription="@string/back"
			android:padding="12dp"
			android:src="@drawable/ic_fluent_arrow_left_24_filled"
			android:tint="#FFFFFF"/>

		<TextView
			android:id="@+id/camera_certification_title"
			android:layout_width="0dp"
			android:layout_height="48dp"
			android:layout_weight="1"
			android:gravity="center"
			android:text="@string/vr_cam_title"
			android:textColor="#9DA1A1"
			android:textSize="14sp"
			android:visibility="gone"/>

		<TextView
			android:id="@+id/recording_timer"
			android:layout_width="0dp"
			android:layout_height="48dp"
			android:layout_weight="1"
			android:gravity="center"
			android:text="00:00"
			android:textColor="#FFFFFF"
			android:textSize="16sp"
			android:textStyle="bold"
			android:visibility="gone"/>

		<ImageButton
			android:id="@+id/camera_flash"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="@android:color/transparent"
			android:contentDescription="@string/media_camera_flash_off"
			android:padding="12dp"
			android:src="@drawable/ic_fluent_flash_off_24_filled"
			android:tint="#FFFFFF"/>
	</LinearLayout>

	<ScrollView
		android:id="@+id/camera_certification_panel"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:layout_marginTop="64dp"
		android:layout_marginHorizontal="16dp"
		android:background="@drawable/bg_camera_requirements"
		android:visibility="gone">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="12dp"
			android:paddingTop="11dp"
			android:paddingEnd="12dp"
			android:paddingBottom="12dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/vr_cam_requirements"
					android:textColor="?attr/vrTextPrimary"
					android:textSize="12sp"
					android:textStyle="bold"/>

				<ImageView
					android:id="@+id/camera_req_collapse"
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:background="@drawable/vr_bg_collapse"
					android:contentDescription="@string/vr_cam_collapse"
					android:padding="4dp"
					android:src="@drawable/ic_fluent_chevron_up_16_regular"
					android:tint="?attr/vrTextPrimary"/>
			</LinearLayout>

			<LinearLayout
				android:id="@+id/camera_req_body"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="vertical">
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:orientation="horizontal">

				<TextView
					android:layout_width="14dp"
					android:layout_height="14dp"
					android:background="@drawable/vr_bg_step"
					android:gravity="center"
					android:includeFontPadding="false"
					android:text="1"
					android:textColor="?attr/vrStepText"
					android:textSize="8sp"
					android:textStyle="bold"/>

				<TextView
					android:id="@+id/camera_req_1"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="10dp"
					android:layout_weight="1"
					android:textColor="?attr/vrTextPrimary"
					android:textSize="11sp"/>
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="horizontal">

				<TextView
					android:layout_width="14dp"
					android:layout_height="14dp"
					android:background="@drawable/vr_bg_step"
					android:gravity="center"
					android:includeFontPadding="false"
					android:text="2"
					android:textColor="?attr/vrStepText"
					android:textSize="8sp"
					android:textStyle="bold"/>

				<TextView
					android:id="@+id/camera_req_2"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="10dp"
					android:layout_weight="1"
					android:text="@string/vr_cam_step2"
					android:textColor="?attr/vrTextPrimary"
					android:textSize="11sp"/>
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="horizontal">

				<TextView
					android:layout_width="14dp"
					android:layout_height="14dp"
					android:background="@drawable/vr_bg_step"
					android:gravity="center"
					android:includeFontPadding="false"
					android:text="3"
					android:textColor="?attr/vrStepText"
					android:textSize="8sp"
					android:textStyle="bold"/>

				<TextView
					android:id="@+id/camera_req_3"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="10dp"
					android:layout_weight="1"
					android:textColor="?attr/vrTextPrimary"
					android:textSize="11sp"/>
			</LinearLayout>

			<TextView
				android:id="@+id/camera_certification_meta"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:fontFamily="monospace"
				android:textColor="?attr/vrTextSecondary"
				android:textSize="10sp"/>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>

	<FrameLayout
		android:id="@+id/camera_capture_controls"
		android:layout_width="match_parent"
		android:layout_height="132dp"
		android:layout_gravity="bottom"
		android:background="#66000000">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/camera_capture_hint"
			android:layout_gravity="top|center_horizontal"
			android:layout_marginTop="8dp"
			android:text="@string/media_camera_capture_hint"
			android:textColor="#CCFFFFFF"
			android:textSize="10sp"/>

		<ImageButton
			android:id="@+id/camera_gallery"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_gravity="start|center_vertical"
			android:layout_marginStart="28dp"
			android:background="@drawable/bg_media_camera_control"
			android:contentDescription="@string/media_picker_title"
			android:padding="12dp"
			android:src="@drawable/ic_photo_library_wght700_20px"
			android:tint="#FFFFFF"/>

		<org.joinmastodon.android.ui.views.MediaCameraShutterView
			android:id="@+id/camera_shutter"
			android:layout_width="56dp"
			android:layout_height="56dp"
			android:layout_gravity="bottom|center_horizontal"
			android:layout_marginBottom="24dp"/>

		<ImageView
			android:id="@+id/camera_certification_shutter"
			android:layout_width="56dp"
			android:layout_height="56dp"
			android:layout_gravity="bottom|center_horizontal"
			android:layout_marginBottom="24dp"
			android:background="@drawable/bg_camera_shutter_white"
			android:contentDescription="@string/media_camera_capture_hint"
			android:padding="16dp"
			android:src="@drawable/ic_fluent_camera_24_regular"
			android:tint="#1A1A1A"
			android:visibility="gone"/>

		<ImageButton
			android:id="@+id/camera_switch"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_gravity="end|center_vertical"
			android:layout_marginEnd="28dp"
			android:background="@drawable/bg_media_camera_control"
			android:contentDescription="@string/media_camera_switch"
			android:padding="12dp"
			android:src="@drawable/ic_fluent_camera_switch_24_filled"
			android:tint="#FFFFFF"/>
	</FrameLayout>

	<LinearLayout
		android:id="@+id/camera_certification_timer_pill"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|center_horizontal"
		android:layout_marginBottom="156dp"
		android:background="@drawable/bg_camera_timer_pill"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="14dp"
		android:paddingTop="8dp"
		android:paddingEnd="14dp"
		android:paddingBottom="8dp"
		android:visibility="gone">

		<ImageView
			android:layout_width="16dp"
			android:layout_height="16dp"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_fluent_clock_24_regular"
			android:tint="#2667FF"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="6dp"
			android:text="@string/vr_cam_remaining"
			android:textColor="?attr/vrTextSecondary"
			android:textSize="10sp"/>

		<TextView
			android:id="@+id/camera_certification_timer"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="10dp"
			android:textColor="?attr/vrTextPrimary"
			android:textSize="12.5sp"
			android:textStyle="bold"/>
	</LinearLayout>

	<LinearLayout
		android:id="@+id/camera_review_controls"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:background="@drawable/bg_camera_review_sheet"
		android:orientation="vertical"
		android:visibility="gone">

		<TextView
			android:id="@+id/camera_review_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:text="@string/vr_cam_preview_title"
			android:textColor="?attr/vrTextPrimary"
			android:textSize="17sp"
			android:fontFamily="sans-serif-medium"/>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:paddingStart="16dp"
			android:paddingTop="12dp"
			android:paddingEnd="16dp"
			android:paddingBottom="20dp">

			<Button
				android:id="@+id/camera_retake"
				android:layout_width="0dp"
				android:layout_height="50dp"
				android:layout_marginEnd="8dp"
				android:layout_weight="1"
				android:background="@drawable/bg_camera_review_outline"
				android:text="@string/media_camera_retake"
				android:textAllCaps="false"
				android:textColor="?attr/vrTextPrimary"
				android:textSize="13sp"/>

			<Button
				android:id="@+id/camera_use"
				android:layout_width="0dp"
				android:layout_height="50dp"
				android:layout_marginStart="8dp"
				android:layout_weight="1"
				android:background="@drawable/vr_bg_primary"
				android:text="@string/media_camera_use_photo"
				android:textAllCaps="false"
				android:textColor="?attr/vrOnPrimary"
				android:textSize="13sp"/>
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
