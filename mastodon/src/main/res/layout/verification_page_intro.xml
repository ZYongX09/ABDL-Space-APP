<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/verification_form_card"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/vr_page"
	android:orientation="vertical">

	<!-- Design: back at x=12, locale pill at x=260 of a 321dp-wide frame. -->
	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="46dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp">

		<ImageButton
			android:id="@+id/verification_back_intro"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:layout_gravity="start|top"
			android:layout_marginTop="5dp"
			android:background="@android:color/transparent"
			android:contentDescription="@string/back"
			android:padding="8dp"
			android:src="@drawable/ic_fluent_arrow_left_24_regular"
			android:tint="@color/vr_text_primary"/>

		<TextView
			android:id="@+id/verification_locale_pill"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end|top"
			android:layout_marginTop="12dp"
			android:background="@drawable/vr_bg_pill"
			android:drawableStart="@drawable/ic_vr_globe_20"
			android:drawablePadding="5dp"
			android:gravity="center"
			android:minWidth="48dp"
			android:paddingStart="9dp"
			android:paddingTop="6dp"
			android:paddingEnd="7dp"
			android:paddingBottom="6dp"
			android:text="ZH"
			android:textColor="@color/vr_text_primary"
			android:textSize="11sp"/>
	</FrameLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp">

		<ImageView
			android:id="@+id/verification_hero_icon"
			android:layout_width="45dp"
			android:layout_height="45dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="3dp"
			android:importantForAccessibility="no"
			android:src="@drawable/abdl_icon_hero"/>

		<TextView
			android:id="@+id/verification_hero_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center"
			android:text="@string/vr_intro_title"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Title"/>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:gravity="center"
			android:text="@string/vr_intro_subtitle"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Subtitle"/>

		<!-- The design has no card around this row: icon chip + two text lines on the page. -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingTop="8dp"
			android:paddingBottom="8dp">

			<FrameLayout
				android:layout_width="26dp"
				android:layout_height="26dp"
				android:background="@drawable/vr_bg_icon_tile">

				<ImageView
					android:layout_width="15dp"
					android:layout_height="15dp"
					android:layout_gravity="center"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_fluent_camera_24_regular"
					android:tint="@color/vr_text_primary"/>
			</FrameLayout>

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="11dp"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/vr_intro_tile_title"
					android:textColor="@color/vr_text_primary"
					android:textSize="12sp"
					android:fontFamily="sans-serif-medium"/>

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/vr_intro_tile_body"
					android:textColor="@color/vr_text_secondary"
					android:textSize="11sp"/>
			</LinearLayout>
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="30dp"
			android:background="@drawable/vr_bg_info"
			android:orientation="horizontal"
			android:paddingStart="12dp"
			android:paddingTop="11dp"
			android:paddingEnd="12dp"
			android:paddingBottom="11dp">

			<ImageView
				android:layout_width="15dp"
				android:layout_height="15dp"
				android:layout_marginTop="1dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_fluent_shield_checkmark_24_regular"
				android:tint="@color/vr_primary"/>

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/vr_intro_info_line1"
					android:textColor="@color/vr_text_primary"
					android:textSize="11sp"/>

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="@string/vr_intro_info_line2"
					android:textColor="@color/vr_text_primary"
					android:textSize="11sp"/>
			</LinearLayout>
		</LinearLayout>

		<TextView
			android:id="@+id/verification_quota_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:visibility="gone"/>

		<TextView
			android:id="@+id/verification_quota_value"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:visibility="gone"/>
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="10dp"
		android:paddingEnd="16dp"
		android:paddingBottom="16dp">

		<TextView
			android:id="@+id/verification_form_note"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="10dp"
			android:gravity="center"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Caption"
			android:visibility="gone"/>

		<Button
			android:id="@+id/verification_start_button"
			style="@style/Widget.Mastodon.Verification2.PrimaryButton"
			android:layout_width="match_parent"
			android:layout_height="43dp"
			android:enabled="false"
			android:text="@string/vr_continue"/>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center"
			android:lineSpacingExtra="2dp"
			android:text="@string/vr_legal"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Caption"
			android:textColor="@color/vr_text_muted"
			android:textSize="10sp"/>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/vr_footer"
			android:textAppearance="@style/TextAppearance.Mastodon.Verification2.Footer"/>
	</LinearLayout>
</LinearLayout>
