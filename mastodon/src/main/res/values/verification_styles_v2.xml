<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Redesigned baby-verification screens (2026-11). Font family stays the system default. -->
	<style name="TextAppearance.Mastodon.Verification2.Title" parent="">
		<item name="android:textSize">21sp</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:textColor">?attr/vrTextPrimary</item>
		<item name="android:letterSpacing">0</item>
	</style>
	<style name="TextAppearance.Mastodon.Verification2.Subtitle" parent="">
		<item name="android:textSize">13sp</item>
		<item name="android:textColor">?attr/vrTextSecondary</item>
	</style>
	<style name="TextAppearance.Mastodon.Verification2.Section" parent="">
		<item name="android:textSize">11sp</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:textColor">?attr/vrTextSecondary</item>
	</style>
	<style name="TextAppearance.Mastodon.Verification2.Body" parent="">
		<item name="android:textSize">13sp</item>
		<item name="android:textColor">?attr/vrTextPrimary</item>
	</style>
	<style name="TextAppearance.Mastodon.Verification2.Caption" parent="">
		<item name="android:textSize">10sp</item>
		<item name="android:textColor">?attr/vrTextSecondary</item>
	</style>
	<style name="TextAppearance.Mastodon.Verification2.Footer" parent="">
		<item name="android:textSize">10sp</item>
		<item name="android:textColor">?attr/vrTextMuted</item>
		<item name="android:gravity">center</item>
	</style>
	<style name="Widget.Mastodon.Verification2.PrimaryButton" parent="@android:style/Widget.Button">
		<item name="android:background">@drawable/vr_bg_primary</item>
		<item name="android:textColor">?attr/vrOnPrimary</item>
		<item name="android:textSize">13sp</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:minHeight">43dp</item>
		<item name="android:stateListAnimator">@null</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
	</style>
	<style name="Widget.Mastodon.Verification2.SecondaryButton" parent="@android:style/Widget.Button">
		<item name="android:background">@drawable/vr_bg_secondary</item>
		<item name="android:textColor">?attr/vrTextPrimary</item>
		<item name="android:textSize">13sp</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:minHeight">43dp</item>
		<item name="android:stateListAnimator">@null</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
	</style>
	<style name="Widget.Mastodon.Verification2.TextButton" parent="@android:style/Widget.Button">
		<item name="android:background">@android:color/transparent</item>
		<item name="android:textColor">?attr/vrTextPrimary</item>
		<item name="android:textSize">13sp</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:minHeight">43dp</item>
		<item name="android:stateListAnimator">@null</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
	</style>
</resources>
